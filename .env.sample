AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_RESOURCE_GROUP=<resource-group-name>
AZURE_LOCATION=<azure-region>
FOUNDRY_ACCOUNT_NAME=<foundry-account-name>

EXPERIMENTATION_PROJECT_NAME=<experimentation-project-name>
EXPERIMENTATION_PROJECT_DISPLAY_NAME=<experimentation-project-display-name>
EXPERIMENTATION_LOG_ANALYTICS_NAME=<experimentation-log-analytics-name>
EXPERIMENTATION_APPLICATION_INSIGHTS_NAME=<experimentation-application-insights-name>

GOVERNED_PROJECT_NAME=<governed-project-name>
GOVERNED_PROJECT_DISPLAY_NAME=<governed-project-display-name>
GOVERNED_LOG_ANALYTICS_NAME=<governed-log-analytics-name>
GOVERNED_APPLICATION_INSIGHTS_NAME=<governed-application-insights-name>
PROJECT_ENDPOINT=https://<foundry-account-name>.services.ai.azure.com/api/projects/<governed-project-name>
MODEL_DEPLOYMENT_NAME=<model-deployment-name>
PROMPT_AGENT_NAME=<prompt-agent-name>
RAG_AGENT_NAME=<rag-agent-name>
AZURE_AI_SEARCH_CONNECTION_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.CognitiveServices/accounts/<foundry-account-name>/projects/<governed-project-name>/connections/<search-connection-name>
AZURE_AI_SEARCH_INDEX_NAME=<search-index-name>
AZURE_AI_SEARCH_QUERY_TYPE=vector_semantic_hybrid
AZURE_AI_SEARCH_TOP_K=5

APP_SERVICE_PLAN_NAME=<app-service-plan-name>
WEB_APP_NAME=<globally-unique-web-app-name>
APP_SERVICE_SKU=B1
# Optional: used by the MAF test helper only with -EnableEasyAuth.
ENTRA_CLIENT_ID=

ADO_AGENT_SERVICE_CONNECTION=<agent-deployment-service-connection>
ADO_INFRASTRUCTURE_SERVICE_CONNECTION=<infrastructure-service-connection>
ADO_APP_SERVICE_CONNECTION=<app-service-deployment-service-connection>
ADO_INFRASTRUCTURE_ENVIRONMENT_NAME=<infrastructure-environment-name>
ADO_AGENT_ENVIRONMENT_NAME=<agent-environment-name>
ADO_MAF_ENVIRONMENT_NAME=<maf-environment-name>
ADO_AGENT365_SERVICE_CONNECTION=<agent-365-service-connection>
ADO_AGENT365_ENVIRONMENT_NAME=<agent-365-environment-name>

AGENT365_ENABLED=false
AGENT365_MAF_AGENT_NAME=<maf-agent-365-registration-name>
AGENT365_AUTH_MODE=s2s
A365_BLUEPRINT_CLIENT_ID=
A365_AGENT_CLIENT_ID=
A365_BOOTSTRAP_CLIENT_ID=
ENABLE_A365_OBSERVABILITY_EXPORTER=true
A365_USE_S2S_ENDPOINT=true
A365_SUPPRESS_INVOKE_AGENT_INPUT=true
