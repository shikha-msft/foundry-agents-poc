PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project-name>
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=
AZURE_FEDERATED_TOKEN_FILE=
IDENTITY_ENDPOINT=
MSI_ENDPOINT=
AZURE_CLI_PROCESS_TIMEOUT=60
MODEL_DEPLOYMENT_NAME=<model-deployment-name>
AGENT_NAME=<rag-agent-name>
APPLICATION_INSIGHTS_RESOURCE_NAME=<application-insights-resource-name>
AZURE_AI_SEARCH_CONNECTION_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<project-name>/connections/<search-connection-name>
AZURE_AI_SEARCH_INDEX_NAME=<search-index-name>
AZURE_AI_SEARCH_QUERY_TYPE=vector_semantic_hybrid
AZURE_AI_SEARCH_TOP_K=5

# Azure supplies IDENTITY_ENDPOINT or MSI_ENDPOINT to managed-identity hosts.
